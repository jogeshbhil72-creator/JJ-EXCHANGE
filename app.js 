
"use strict";

// JJ EXCHANGE | JINEX JACKKY
// Educational demo dashboard only.
// All prices and candles below are simulated, not live market data.

const $ = (id) => document.getElementById(id);

const assets = {
  BTC: { name: "Bitcoin", symbol: "BTC/USDT", base: 67420 },
  ETH: { name: "Ethereum", symbol: "ETH/USDT", base: 3520 },
  SOL: { name: "Solana", symbol: "SOL/USDT", base: 178 },
  EURUSD: { name: "Euro / US Dollar", symbol: "EUR/USD", base: 1.085 }
};

let selectedAsset = "BTC";
let selectedTime = "1H";
let candles = [];
let resizeObserver = null;

function seededRandom(seed) {
  let value = seed >>> 0;
  return function () {
    value = (value * 1664525 + 1013904223) >>> 0;
    return value / 4294967296;
  };
}

function makeCandles(assetKey) {
  const random = seededRandom(
    assetKey.split("").reduce((sum, char) => sum + char.charCodeAt(0), 0) +
    selectedTime.length * 100
  );

  const base = assets[assetKey].base;
  const result = [];
  let previous = base * 0.96;

  for (let i = 0; i < 48; i++) {
    const movement = (random() - 0.47) * base * 0.012;
    const open = previous;
    const close = Math.max(base * 0.5, open + movement);
    const high = Math.max(open, close) + random() * base * 0.004;
    const low = Math.min(open, close) - random() * base * 0.004;

    result.push({ open, close, high, low });
    previous = close;
  }

  return result;
}

function formatPrice(value) {
  if (selectedAsset === "EURUSD") return value.toFixed(5);
  return value.toLocaleString("en-US", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2
  });
}

function getChange() {
  const first = candles[0].close;
  const last = candles[candles.length - 1].close;
  return ((last - first) / first) * 100;
}

function renderMarketRows() {
  const marketRows = $("marketRows");
  if (!marketRows) return;

  marketRows.textContent = "";

  Object.entries(assets).forEach(([key, asset]) => {
    const data = makeCandles(key);
    const change = ((data[data.length - 1].close - data[0].close) / data[0].close) * 100;

    const row = document.createElement("tr");

    const nameCell = document.createElement("td");
    nameCell.textContent = `${asset.name} (${asset.symbol})`;

    const priceCell = document.createElement("td");
    priceCell.textContent = key === "EURUSD"
      ? data[data.length - 1].close.toFixed(5)
      : data[data.length - 1].close.toLocaleString("en-US", {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        });

    const changeCell = document.createElement("td");
    changeCell.textContent = `${change >= 0 ? "+" : ""}${change.toFixed(2)}%`;
    changeCell.style.color = change >= 0 ? "#16c784" : "#ea3943";

    row.append(nameCell, priceCell, changeCell);

    row.addEventListener("click", () => {
      selectedAsset = key;
      updateDashboard();
    });

    marketRows.appendChild(row);
  });
}

function drawChart() {
  const canvas = $("priceChart");
  if (!canvas) return;

  const rect = canvas.getBoundingClientRect();
  const width = Math.max(300, rect.width);
  const height = Math.max(220, rect.height || 280);
  const ratio = window.devicePixelRatio || 1;

  canvas.width = Math.floor(width * ratio);
  canvas.height = Math.floor(height * ratio);

  const ctx = canvas.getContext("2d");
  ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
  ctx.clearRect(0, 0, width, height);

  const padding = { top: 18, right: 58, bottom: 22, left: 8 };
  const chartWidth = width - padding.left - padding.right;
  const chartHeight = height - padding.top - padding.bottom;

  const values = candles.flatMap(c => [c.high, c.low]);
  const max = Math.max(...values);
  const min = Math.min(...values);
  const range = max - min || 1;

  const y = value => padding.top + ((max - value) / range) * chartHeight;

  ctx.strokeStyle = "rgba(255,255,255,0.08)";
  ctx.lineWidth = 1;

  for (let i = 0; i <= 4; i++) {
    const lineY = padding.top + (chartHeight / 4) * i;
    ctx.beginPath();
    ctx.moveTo(padding.left, lineY);
    ctx.lineTo(width - padding.right, lineY);
    ctx.stroke();
  }

  const gap = chartWidth / candles.length;
  const candleWidth = Math.max(3, gap * 0.58);

  candles.forEach((candle, index) => {
    const x = padding.left + index * gap + gap / 2;
    const up = candle.close >= candle.open;
    const color = up ? "#16c784" : "#ea3943";

    ctx.strokeStyle = color;
    ctx.fillStyle = color;
    ctx.lineWidth = 1.3;

    ctx.beginPath();
    ctx.moveTo(x, y(candle.high));
    ctx.lineTo(x, y(candle.low));
    ctx.stroke();

    const top = y(Math.max(candle.open, candle.close));
    const bottom = y(Math.min(candle.open, candle.close));
    const bodyHeight = Math.max(2, bottom - top);

    ctx.fillRect(
      x - candleWidth / 2,
      top,
      candleWidth,
      bodyHeight
    );
  });

  ctx.fillStyle = "#9ca3af";
  ctx.font = "11px Arial";
  ctx.textAlign = "left";

  for (let i = 0; i <= 4; i++) {
    const value = max - (range / 4) * i;
    const lineY = padding.top + (chartHeight / 4) * i;
    ctx.fillText(formatPrice(value), width - padding.right + 7, lineY + 4);
  }

  ctx.textAlign = "center";
  ctx.fillText("Illustrative demo candles", width / 2, height - 4);
}

function calculateRSI(data) {
  let gains = 0;
  let losses = 0;

  for (let i = 1; i < data.length; i++) {
    const difference = data[i].close - data[i - 1].close;
    if (difference > 0) gains += difference;
    else losses += Math.abs(difference);
  }

  if (losses === 0) return 100;
  const rs = gains / losses;
  return 100 - 100 / (1 + rs);
}

function updateIndicators() {
  const closes = candles.map(c => c.close);
  const rsi = calculateRSI(candles);
  const ema = closes.reduce((sum, value) => sum + value, 0) / closes.length;
  const change = getChange();

  if ($("rsiValue")) $("rsiValue").textContent = rsi.toFixed(1);
  if ($("emaValue")) $("emaValue").textContent = formatPrice(ema);

  if ($("biasValue")) {
    $("biasValue").textContent = change >= 0 ? "Bullish" : "Bearish";
    $("biasValue").style.color = change >= 0 ? "#16c784" : "#ea3943";
  }

  if ($("analysisText")) {
    let message = "The simulated market is moving with mixed signals.";

    if (rsi >= 70) {
      message = "Simulated RSI is in the higher zone. Study price action carefully.";
    } else if (rsi <= 30) {
      message = "Simulated RSI is in the lower zone. Study price action carefully.";
    } else if (change > 0) {
      message = "The simulated candles show upward movement. This is educational data, not a trade signal.";
    } else {
      message = "The simulated candles show downward movement. This is educational data, not a trade signal.";
    }

    $("analysisText").textContent = message;
  }
}

function updateDashboard() {
  candles = makeCandles(selectedAsset);

  const asset = assets[selectedAsset];
  const latest = candles[candles.length - 1];
  const change = getChange();

  if ($("assetSelect")) $("assetSelect").value = selectedAsset;
  if ($("timeSelect")) $("timeSelect").value = selectedTime;

  if ($("chartCaption")) {
    $("chartCaption").textContent =
      `${asset.symbol} | ${selectedTime} | SIMULATED MARKET`;
  }

  if ($("walletBalance")) {
    $("walletBalance").textContent = "10,000.00";
  }

  updateIndicators();
  drawChart();

  const currentPrice = $("currentPrice");
  if (currentPrice) currentPrice.textContent = formatPrice(latest.close);

  const marketChange = $("marketChange");
  if (marketChange) {
    marketChange.textContent = `${change >= 0 ? "+" : ""}${change.toFixed(2)}%`;
    marketChange.style.color = change >= 0 ? "#16c784" : "#ea3943";
  }
}

function setupControls() {
  const assetSelect = $("assetSelect");
  if (assetSelect) {
    assetSelect.addEventListener("change", event => {
      if (assets[event.target.value]) {
        selectedAsset = event.target.value;
        updateDashboard();
      }
    });
  }

  const timeSelect = $("timeSelect");
  if (timeSelect) {
    timeSelect.addEventListener("change", event => {
      selectedTime = event.target.value;
      updateDashboard();
    });
  }

  const menuBtn = $("menuBtn");
  const sidebar = $("sidebar");

  if (menuBtn && sidebar) {
    menuBtn.addEventListener("click", () => {
      sidebar.classList.toggle("open");
    });
  }

  window.addEventListener("resize", drawChart);
}

function startDashboard() {
  setupControls();
  renderMarketRows();
  updateDashboard();

  const canvas = $("priceChart");
  if (canvas && "ResizeObserver" in window) {
    resizeObserver = new ResizeObserver(drawChart);
    resizeObserver.observe(canvas);
  }
}

if (document.readyState === "loading") {
  document.addEventListener("DOMContentLoaded", startDashboard);
} else {
  startDashboard();
}